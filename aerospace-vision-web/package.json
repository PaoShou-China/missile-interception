{
  "name": "aerospace-vision-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aerospace Vision Web — scientific 3D visualization platform for aerospace trajectories, driven by validated simulation telemetry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "data:build": "python tools/data-adapter/build_scenario.py",
    "data:verify": "python tools/data-adapter/verify_scenario.py",
    "perf:soak": "node scripts/soak.mjs --minutes 10"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "echarts": "6.1.0",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
