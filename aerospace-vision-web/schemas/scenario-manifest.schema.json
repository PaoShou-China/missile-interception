{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerospace-vision.local/schemas/scenario-manifest.schema.json",
  "title": "Aerospace Vision Scenario Manifest",
  "description": "Frozen public contract v1.0.0 between the Python data adapter and the web renderer. All lengths are SI (metres) unless explicitly suffixed; the renderer converts to kilometres. Positions are WGS84 ECEF, attitudes are scalar-first BODY->ECEF quaternions.",
  "type": "object",
  "required": [
    "schemaVersion", "id", "title", "earth", "time", "frames", "source",
    "metrics", "launchSite", "targetSite", "phases", "events", "observables",
    "entities", "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "earth": {
      "type": "object",
      "required": ["model", "semiMajorAxisM", "flattening", "omegaRadS", "muM3S2"],
      "properties": {
        "model": { "enum": ["wgs84", "sphere"] },
        "semiMajorAxisM": { "type": "number" },
        "flattening": { "type": "number" },
        "omegaRadS": { "type": "number" },
        "muM3S2": { "type": "number" }
      }
    },
    "time": {
      "type": "object",
      "required": ["startS", "endS", "sampleCount", "sourceRows", "sourceStepS"],
      "properties": {
        "startS": { "type": "number" },
        "endS": { "type": "number" },
        "sampleCount": { "type": "integer", "minimum": 2 },
        "sourceRows": { "type": "integer" },
        "sourceStepS": { "type": "number" }
      }
    },
    "frames": {
      "type": "object",
      "required": ["render", "eciToEcef", "quaternion", "bodyAxes"],
      "properties": {
        "render": { "const": "ECEF" },
        "eciToEcef": { "type": "string" },
        "quaternion": { "type": "string" },
        "bodyAxes": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "repository", "telemetryFile", "telemetryRows", "generatedAt", "generator"],
      "properties": {
        "title": { "type": "string" },
        "repository": { "type": "string" },
        "commit": { "type": "string" },
        "telemetryFile": { "type": "string" },
        "telemetryRows": { "type": "integer" },
        "sha256": { "type": "string" },
        "generatedAt": { "type": "string" },
        "generator": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "missDistanceM", "interceptTimeS", "maxSpeedMS", "maxMach",
        "maxDynamicPressurePa", "maxLoadG", "maxAltitudeM", "downrangeKM",
        "fuelUsedKg", "flightDurationS"
      ],
      "properties": {
        "missDistanceM": { "type": "number" },
        "interceptTimeS": { "type": "number" },
        "maxSpeedMS": { "type": "number" },
        "maxMach": { "type": "number" },
        "maxDynamicPressurePa": { "type": "number" },
        "maxLoadG": { "type": "number" },
        "maxAltitudeM": { "type": "number" },
        "downrangeKM": { "type": "number" },
        "fuelUsedKg": { "type": "number" },
        "handoverTimeS": { "type": ["number", "null"] },
        "flightDurationS": { "type": "number" }
      }
    },
    "launchSite": { "$ref": "#/$defs/site" },
    "targetSite": { "$ref": "#/$defs/site" },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "startT", "endT", "label"],
        "properties": {
          "phase": { "enum": ["boost", "midcourse", "terminal", "coast"] },
          "startT": { "type": "number" },
          "endT": { "type": "number" },
          "label": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "t", "label", "kind", "severity"],
        "properties": {
          "id": { "type": "string" },
          "t": { "type": "number" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "kind": { "enum": ["launch", "phase", "lock", "handover", "intercept", "peak", "custom"] },
          "severity": { "enum": ["info", "major", "critical"] }
        }
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "unit"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "description": { "type": "string" },
          "precision": { "type": "integer" }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "color", "samples"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "enum": ["missile", "target", "payload"] },
          "color": { "type": "string" },
          "samples": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/sample" }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT RUN"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "status", "detail"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "status": { "enum": ["PASS", "FAIL"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": ["latDeg", "lonDeg", "altM", "label"],
      "properties": {
        "latDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "lonDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "altM": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "quat": {
      "type": "object",
      "required": ["w", "x", "y", "z"],
      "properties": {
        "w": { "type": "number" }, "x": { "type": "number" },
        "y": { "type": "number" }, "z": { "type": "number" }
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "t", "position", "velocity", "attitude", "latDeg", "lonDeg", "altM",
        "speedMS", "mach", "qPa", "loadG", "loadCmdG", "massKg", "fovDeg",
        "rangeM", "phase", "seekerLock", "handover"
      ],
      "properties": {
        "t": { "type": "number", "minimum": 0 },
        "position": { "$ref": "#/$defs/vec3", "description": "WGS84 ECEF position, metres" },
        "velocity": { "$ref": "#/$defs/vec3", "description": "ECEF velocity, m/s" },
        "attitude": { "$ref": "#/$defs/quat", "description": "BODY->ECEF, scalar first" },
        "latDeg": { "type": "number" },
        "lonDeg": { "type": "number" },
        "altM": { "type": "number" },
        "speedMS": { "type": "number" },
        "mach": { "type": "number" },
        "qPa": { "type": "number" },
        "loadG": { "type": "number" },
        "loadCmdG": { "type": "number" },
        "massKg": { "type": "number" },
        "fovDeg": { "type": "number" },
        "rangeM": { "type": "number" },
        "phase": { "enum": ["boost", "midcourse", "terminal", "coast"] },
        "seekerLock": { "type": "boolean" },
        "handover": { "type": "boolean" }
      }
    }
  }
}
