{
  "name": "interceptor-vision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Blender-authored interceptor visualisation: realtime Three.js scene plus offline Cycles renders.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
